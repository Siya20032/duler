const express=require("express"),cors=require("cors"),helmet=require("helmet");
const config=require("./config"),sequelize=require("./db");
require("./models");
const authRoutes=require("./routes/auth"),projectRoutes=require("./routes/projects"),queueRoutes=require("./routes/queues"),jobRoutes=require("./routes/jobs"),dlqRoutes=require("./routes/dlq"),workerRoutes=require("./routes/workers"),scheduledRoutes=require("./routes/scheduledJobs"),metricsRoutes=require("./routes/metrics");
const {startScheduler}=require("./services/scheduler");

const app=express();
app.use(helmet());
app.use(cors({origin:(origin,cb)=>{if(!origin||config.corsOrigins.includes(origin))return cb(null,true);cb(new Error("CORS origin not allowed"));},credentials:true}));
app.use(express.json({limit:"2mb"}));

app.get("/",(req,res)=>res.json({name:config.appName,version:config.appVersion,status:"running"}));
app.get("/health",(req,res)=>res.json({status:"healthy"}));
app.get("/health/database",async(req,res)=>{try{await sequelize.authenticate();res.json({status:"healthy",database:"connected"});}catch{res.json({status:"unhealthy",database:"disconnected"});}});

app.use(authRoutes);app.use(projectRoutes);app.use(queueRoutes);app.use(jobRoutes);app.use(dlqRoutes);app.use(workerRoutes);app.use(scheduledRoutes);app.use(metricsRoutes);

app.use((err,req,res,next)=>{console.error(err);if(err.name==="SequelizeUniqueConstraintError")return res.status(409).json({detail:"A resource with the same unique value already exists"});res.status(err.status||500).json({detail:err.message||"Internal server error"});});

async function start(){try{await sequelize.authenticate();console.log("PostgreSQL connected");await sequelize.sync();console.log("Database models synchronized");app.listen(config.port,"0.0.0.0",()=>console.log(`Node.js + Express API running on http://127.0.0.1:${config.port}`));startScheduler();}catch(e){console.error("Startup failed:",e);process.exit(1);}}
start();
module.exports=app;
